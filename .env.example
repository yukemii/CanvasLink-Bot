# CanvasLink Environment Variables
# Copy this file to .env and fill in your values.

# Telegram Bot API token (from @BotFather)
CANVASLINK_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL connection string
CANVASLINK_DATABASE_URL=postgres://user:password@localhost:5432/canvaslink?sslmode=disable

# Google OAuth credentials (from Google Cloud Console)
# These are required for Google Calendar sync.
CANVASLINK_GOOGLE_CLIENT_ID=your_google_client_id_here
CANVASLINK_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OAuth redirect URL — must match the redirect URI configured in Google Cloud Console
# This is the URL Google sends the user back to after authorization.
# For local development: http://localhost:9090/oauth/callback
# For production: https://your-domain.com/oauth/callback
CANVASLINK_OAUTH_REDIRECT_URL=http://localhost:9090/oauth/callback

# OAuth HTTP server listen address (for the callback endpoint)
CANVASLINK_OAUTH_LISTEN_ADDR=:9090

# Sync interval (optional, default: 1h)
# CANVASLINK_SYNC_INTERVAL=1h

# Custom course code regex pattern (optional)
# Overrides the default course code detection regex for non-NUS universities.
# Default: (?i)(?:\[|\b)([A-Z]{2,4}\d{3,4}[A-Z]?)(?:\]|\b)
# Examples:
#   For purely numeric codes: (?i)(?:\[|\b)(\d{4,6})(?:\]|\b)
#   For codes with hyphens:  (?i)(?:\[|\b)([A-Z]{2,4}-\d{3,4}[A-Z]?)(?:\]|\b)
# CANVASLINK_COURSE_REGEX=
