# CanvasLink Environment Variables
# Copy this file to .env and fill in your values.

# Telegram Bot API token (from @BotFather)
CANVASLINK_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL connection string. sslmode=disable is for a trusted local
# development database only. For remote production PostgreSQL, use certificate
# and hostname verification (for example sslmode=verify-full plus sslrootcert).
CANVASLINK_DATABASE_URL=postgres://user:password@localhost:5432/canvaslink?sslmode=disable

# Required application encryption key. Generate 32 random bytes and encode
# them as base64, for example: openssl rand -base64 32
CANVASLINK_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key
CANVASLINK_ENCRYPTION_KEY_ID=primary

# Stable deployment namespace used in deterministic Google event IDs and
# ownership markers. Keep this unchanged for the lifetime of a deployment.
CANVASLINK_INSTANCE_ID=canvaslink

# During a key rotation, first stop/drain every old CanvasLink writer. Keep old
# keys available as comma-separated key_id:base64_key entries while one updated
# instance completes startup migration, then start all instances with the same
# key configuration. See README.md before removing an old key.
# CANVASLINK_PREVIOUS_ENCRYPTION_KEYS=old-2026:base64_key_here

# Google OAuth credentials (from Google Cloud Console)
# Set both values to enable Google Calendar sync. Leave both blank to run with
# Telegram-only review notifications.
CANVASLINK_GOOGLE_CLIENT_ID=your_google_client_id_here
CANVASLINK_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OAuth redirect URL — must match the redirect URI configured in Google Cloud Console
# This is the URL Google sends the user back to after authorization.
# For local development: http://localhost:9090/oauth/callback
# For production: https://your-domain.com/oauth/callback
CANVASLINK_OAUTH_REDIRECT_URL=http://localhost:9090/oauth/callback

# OAuth HTTP server listen address (callback endpoint only). On a bare host,
# bind to loopback and terminate public HTTPS at a same-host reverse proxy.
# Containers may need :9090, but the port should remain on a private network.
# Configure proxies/CDNs/load balancers not to log /oauth/callback query strings:
# they contain a short-lived Google authorization code and OAuth state.
CANVASLINK_OAUTH_LISTEN_ADDR=127.0.0.1:9090

# Sync interval (optional, default: 1h, minimum: 1m)
# CANVASLINK_SYNC_INTERVAL=1h

# User-facing timezone used for new accounts (IANA name).
# Users can later change their own timezone with /timezone.
CANVASLINK_DEFAULT_TIMEZONE=Asia/Singapore

# Safe Canvas-removal handling. A future event must be absent from this many
# successful feed checks and for at least this long before deletion is queued.
CANVASLINK_REMOVAL_MISSES=3
CANVASLINK_REMOVAL_GRACE_PERIOD=6h

# How often durable Google Calendar jobs are retried.
CANVASLINK_CALENDAR_JOB_INTERVAL=15s

# Security overrides for local development only. Production should leave both
# false so feeds must use HTTPS and resolve exclusively to public IP addresses.
CANVASLINK_ALLOW_INSECURE_FEEDS=false
CANVASLINK_ALLOW_PRIVATE_FEEDS=false

# Custom course code regex pattern (optional)
# Overrides the default course code detection regex for non-NUS universities.
# Default: (?i)(?:\[|\b)([A-Z]{2,4}\d{3,4}[A-Z]?)(?:\]|\b)
# Examples:
#   For purely numeric codes: (?i)(?:\[|\b)(\d{4,6})(?:\]|\b)
#   For codes with hyphens:  (?i)(?:\[|\b)([A-Z]{2,4}-\d{3,4}[A-Z]?)(?:\]|\b)
# CANVASLINK_COURSE_REGEX=
